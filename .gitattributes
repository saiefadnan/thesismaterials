# Git LFS configuration for the thesis_materials project
# Track large binary assets with Git LFS to keep repository lightweight.
# Add or modify patterns as needed for your project.

# PDF documents (e.g., papers, reports)
*.pdf filter=lfs diff=lfs merge=lfs -text
# Images (high‑resolution figures, diagrams)
*.png filter=lfs diff=lfs merge=lfs -text
*.jpg filter=lfs diff=lfs merge=lfs -text
*.jpeg filter=lfs diff=lfs merge=lfs -text
*.gif filter=lfs diff=lfs merge=lfs -text
*.svg filter=lfs diff=lfs merge=lfs -text
# Video and audio files (e.g., presentations, recordings)
*.mp4 filter=lfs diff=lfs merge=lfs -text
*.mov filter=lfs diff=lfs merge=lfs -text
*.avi filter=lfs diff=lfs merge=lfs -text
*.wav filter=lfs diff=lfs merge=lfs -text
*.mp3 filter=lfs diff=lfs merge=lfs -text
# Archives and large datasets
*.zip filter=lfs diff=lfs merge=lfs -text
*.tar.gz filter=lfs diff=lfs merge=lfs -text
*.tgz filter=lfs diff=lfs merge=lfs -text
*.7z filter=lfs diff=lfs merge=lfs -text
# Large CSV or data files
*.csv filter=lfs diff=lfs merge=lfs -text
# Model files (e.g., TensorFlow, PyTorch checkpoints)
*.pt filter=lfs diff=lfs merge=lfs -text
*.pth filter=lfs diff=lfs merge=lfs -text
*.h5 filter=lfs diff=lfs merge=lfs -text
*.ckpt filter=lfs diff=lfs merge=lfs -text
# Ensure Git LFS is initialized (run once in the repo root)
# git lfs install
# Then track the patterns above (already done via .gitattributes)
*.log filter=lfs diff=lfs merge=lfs -text
